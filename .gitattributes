# Normalize text files and store them in Git with LF endings
* text=auto eol=lf

# Julia and project text files
*.jl        text eol=lf
*.toml      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Windows command files genuinely require CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binary files must never be modified
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.mp4       binary
*.pdf       binary
*.zip       binary